DEBUG=True
SECRET_KEY=replace-me
DJANGO_SETTINGS_MODULE=home_sweet_home.settings.local

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=home_sweet_home
POSTGRES_USER=home_sweet_home
POSTGRES_PASSWORD=home_sweet_home
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
WEB_PORT=8000

DATABASE_URL=postgresql://home_sweet_home:home_sweet_home@db:5432/home_sweet_home

# Leave disabled until you have generated VAPID keys for this environment.
PUSH_NOTIFICATIONS_ENABLED=False
TALK_LATER_REMINDER_JOB_TOKEN=replace-with-a-long-random-secret
VAPID_PUBLIC_KEY=replace-with-application-server-key
VAPID_PRIVATE_KEY_PATH=private_key.pem
VAPID_SUBJECT=mailto:replace-with-contact-email@example.com

# Leave disabled until Google Cloud OAuth and Calendar have been configured.
GOOGLE_OAUTH_ENABLED=False
GOOGLE_CALENDAR_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_LEGACY_USER_MAP=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_EVENT_DURATION_MINUTES=30
PASSWORD_LOGIN_ENABLED=True
